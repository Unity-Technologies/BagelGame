<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/UI/Editor/B10_EditorTools/BagelAllUIWindowStyles.uss?fileID=7433441132597879392&amp;guid=c1a6b9dd4e943d04db0791c9618381dd&amp;type=3"/>
    <ui:VisualElement name="window" class="b-window">
        <uie:Toolbar name="toolbar" class="b-toolbar">
            <ui:VisualElement name="state-strip" class="b-toolbar__group">
                <uie:ToolbarToggle text="Main Menu" name="state-main-menu"/>
                <uie:ToolbarToggle text="Selection" name="state-bagel-selection"/>
                <uie:ToolbarToggle text="Playing" name="state-playing"/>
                <uie:ToolbarToggle text="Paused" name="state-paused"/>
                <uie:ToolbarToggle text="Game Over" name="state-game-over"/>
            </ui:VisualElement>
            <uie:ToolbarMenu text="Setups" name="setup-menu"/>
            <uie:ToolbarToggle text="Simulate Roll" name="roll-toggle"/>
            <uie:ToolbarMenu text="Theme" name="theme-menu"/>
            <uie:ToolbarMenu text="Language" name="language-menu"/>
            <uie:ToolbarSpacer style="flex-grow: 1;"/>
            <ui:Slider label="Zoom" low-value="0.5" high-value="1.5" value="1" name="zoom-slider" class="b-toolbar__zoom"/>
            <uie:ToolbarButton text="Reset" name="reset-button"/>
            <uie:ToolbarToggle text="State Inspector" name="inspector-toggle"/>
        </uie:Toolbar>
        <ui:VisualElement name="body" class="b-body">
            <ui:ScrollView mode="VerticalAndHorizontal" name="stage" class="b-stage">
                <ui:VisualElement name="cards" class="b-cards"/>
            </ui:ScrollView>
            <ui:ScrollView name="inspector-dock" class="b-inspector-dock"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

/* Bagel Game: the styles every theme shares. Each color, size and shape is a variable; a theme only
   sets variables (see T1_Classic/BagelClassicThemeStyles.uss). The defaults here are Classic's: the
   bagel shop.

   The UI is made of five surfaces, like the shop is: chalk on the blackboard (.b-board: the main menu),
   marker on the whiteboard beside it (.b-whiteboard: settings), paper (.b-paper: the bagels' price tags,
   the receipt and the leaderboard on the television), the shop window's glass (.b-glass: the pause
   screen) and the kitchen gauges riding along with the bagel (.b-gauge). A surface sets the colors the
   controls inside it read (--b-text-color, --b-line-color...), so a button is chalk on the board and ink
   on paper with the same rules. */

:root {
    /* The shop's palette */
    --b-ink: rgb(59, 31, 20);
    --b-paper: rgb(251, 243, 226);
    --b-kraft: rgb(214, 182, 140);
    --b-chalk: rgb(244, 241, 230);
    --b-crust: rgb(214, 140, 69);
    --b-red: rgb(222, 72, 44);
    --b-chalk-yellow: rgb(247, 213, 110);
    --b-slate: rgb(36, 47, 42);

    /* The blackboard: chalk on the board in the scene, which shows through. */
    --b-board-surface: rgba(0, 0, 0, 0);
    --b-board-text: rgb(244, 241, 230);
    --b-board-title: rgb(247, 213, 110);
    --b-board-line: rgba(244, 241, 230, 0.8);
    --b-board-fill: rgba(244, 241, 230, 0.06);
    --b-board-hover: rgba(244, 241, 230, 0.18);
    --b-board-track: rgba(244, 241, 230, 0.22);
    --b-board-accent: rgb(247, 213, 110);
    --b-board-accent-fill: rgba(247, 213, 110, 0.22);
    --b-board-accent-text: rgb(247, 213, 110);
    --b-board-glow: rgba(244, 241, 230, 0.75);
    --b-board-row: rgba(244, 241, 230, 0.07);
    --b-board-popup: rgb(43, 56, 50);
    /* A free-standing chalkboard sign (no board in the scene behind it), in its wooden frame. */
    --b-frame-color: rgb(140, 90, 60);

    /* The whiteboard: sharp, bright marker on the white board in the scene, which shows through. */
    --b-whiteboard-surface: rgba(0, 0, 0, 0);
    --b-whiteboard-text: rgb(24, 36, 72);
    --b-whiteboard-title: rgb(214, 46, 46);
    --b-whiteboard-line: rgb(34, 84, 186);
    --b-whiteboard-fill: rgba(34, 84, 186, 0.06);
    --b-whiteboard-hover: rgba(34, 84, 186, 0.14);
    --b-whiteboard-track: rgba(24, 36, 72, 0.22);
    --b-whiteboard-accent: rgb(26, 150, 78);
    --b-whiteboard-accent-fill: rgba(26, 150, 78, 0.16);
    --b-whiteboard-accent-text: rgb(18, 116, 58);
    --b-whiteboard-glow: rgba(34, 84, 186, 0.45);
    --b-whiteboard-row: rgba(24, 36, 72, 0.05);
    --b-whiteboard-popup: rgb(250, 251, 253);
    --b-whiteboard-focus: rgb(214, 46, 46);
    /* The title's underline: the four markers in the tray, side by side. */
    --b-marker-a: rgb(214, 46, 46);
    --b-marker-b: rgb(240, 140, 30);
    --b-marker-c: rgb(34, 84, 186);
    --b-marker-d: rgb(26, 150, 78);

    /* Paper: ink on cream, red for what stands out. */
    --b-paper-surface: rgb(251, 243, 226);
    --b-paper-text: rgb(59, 31, 20);
    --b-paper-title: rgb(59, 31, 20);
    --b-paper-line: rgb(59, 31, 20);
    --b-paper-fill: rgb(255, 250, 240);
    --b-paper-hover: rgb(246, 228, 198);
    --b-paper-track: rgba(59, 31, 20, 0.14);
    --b-paper-accent: rgb(222, 72, 44);
    --b-paper-accent-fill: rgb(222, 72, 44);
    --b-paper-accent-text: rgb(255, 248, 234);
    --b-paper-glow: rgba(222, 72, 44, 0.6);
    --b-paper-row: rgba(59, 31, 20, 0.06);
    --b-paper-popup: rgb(255, 248, 234);

    /* The shop window: frosted glass, gold-leaf lettering. */
    --b-glass-surface: rgba(255, 244, 222, 0.18);
    --b-glass-text: rgb(255, 238, 205);
    --b-glass-title: rgb(246, 200, 110);
    --b-glass-line: rgba(246, 200, 110, 0.9);
    --b-glass-fill: rgba(40, 24, 14, 0.35);
    --b-glass-hover: rgba(246, 200, 110, 0.25);
    --b-glass-track: rgba(255, 238, 205, 0.25);
    --b-glass-accent: rgb(246, 200, 110);
    --b-glass-accent-fill: rgba(246, 200, 110, 0.85);
    --b-glass-accent-text: rgb(59, 31, 20);
    --b-glass-glow: rgba(246, 200, 110, 0.8);
    --b-glass-row: rgba(255, 238, 205, 0.08);
    --b-glass-popup: rgb(58, 40, 28);

    /* The kitchen gauges: cream enamel faces, ink ticks, a red needle. */
    --b-gauge-surface: rgb(250, 241, 222);
    --b-gauge-rim: rgb(196, 202, 206);
    --b-gauge-text: rgb(59, 31, 20);
    --b-gauge-line: rgb(59, 31, 20);
    --b-gauge-accent: rgb(222, 72, 44);
    --b-gauge-warn: rgb(232, 168, 56);
    --b-gauge-seed: rgb(251, 243, 226);

    /* The television on the far wall: a broadcast's deep blue behind its paper cards, and the channel's bug. */
    --b-tv-screen-top: rgb(30, 78, 104);
    --b-tv-screen-bottom: rgb(12, 32, 48);
    --b-tv-bug-color: rgb(255, 255, 255);

    /* What the controls read: the board's, until a surface says otherwise (popups open at the panel's
       root, outside any surface). */
    --b-surface-color: var(--b-board-surface);
    --b-text-color: var(--b-board-text);
    --b-title-color: var(--b-board-title);
    --b-line-color: var(--b-board-line);
    --b-fill-color: var(--b-board-fill);
    --b-hover-color: var(--b-board-hover);
    --b-track-color: var(--b-board-track);
    --b-accent-color: var(--b-board-accent);
    --b-accent-fill: var(--b-board-accent-fill);
    --b-accent-text-color: var(--b-board-accent-text);
    --b-glow-color: var(--b-board-glow);
    --b-row-color: var(--b-board-row);
    --b-popup-color: var(--b-board-popup);

    /* The title's underline: a stroke of colored chalk. */
    --b-accent-a: rgb(247, 213, 110);
    --b-accent-b: rgb(244, 160, 160);
    --b-accent-c: rgb(150, 196, 236);
    --b-accent-d: rgb(160, 214, 150);

    /* Text */
    --b-font: url("Fonts/DynaPuff-Medium SDF.asset");
    --b-title-size: 34px;
    --b-main-title-size: 45px;
    --b-details-size: 10px;
    /* The default runtime theme's text size: as big as text that shrinks to fit grows. */
    --b-text-size: 14px;

    /* Focus */
    --b-focus-color: rgb(247, 213, 110);
    --b-focus-width: 2px;

    /* Buttons */
    --b-button-border-width: 3px;

    /* The custom filters: the chalk's grain on the board. A theme without chalk sets it to none. */
    --b-board-filter: filter("/Assets/UI/Runtime/B00_Themes/T0_Common/Filters/Chalk.asset" 0.55 1.6);

    /* Shapes and spacing */
    --b-tiny-radius: 4px;
    --b-inner-radius: 8px;
    --b-element-radius: 12px;
    --b-pane-radius: 18px;
    --b-field-gap: 4px;
    --b-pane-padding: 6px;
    --b-button-padding: 6px;
    --b-progress-bar-padding: 8px;
}

/* ------------------------------------------------------------------ Surfaces */

.b-board {
    --b-surface-color: var(--b-board-surface);
    --b-text-color: var(--b-board-text);
    --b-title-color: var(--b-board-title);
    --b-line-color: var(--b-board-line);
    --b-fill-color: var(--b-board-fill);
    --b-hover-color: var(--b-board-hover);
    --b-track-color: var(--b-board-track);
    --b-accent-color: var(--b-board-accent);
    --b-accent-fill: var(--b-board-accent-fill);
    --b-accent-text-color: var(--b-board-accent-text);
    --b-glow-color: var(--b-board-glow);
    --b-row-color: var(--b-board-row);
    --b-popup-color: var(--b-board-popup);
}

.b-whiteboard {
    --b-surface-color: var(--b-whiteboard-surface);
    --b-text-color: var(--b-whiteboard-text);
    --b-title-color: var(--b-whiteboard-title);
    --b-line-color: var(--b-whiteboard-line);
    --b-fill-color: var(--b-whiteboard-fill);
    --b-hover-color: var(--b-whiteboard-hover);
    --b-track-color: var(--b-whiteboard-track);
    --b-accent-color: var(--b-whiteboard-accent);
    --b-accent-fill: var(--b-whiteboard-accent-fill);
    --b-accent-text-color: var(--b-whiteboard-accent-text);
    --b-glow-color: var(--b-whiteboard-glow);
    --b-row-color: var(--b-whiteboard-row);
    --b-popup-color: var(--b-whiteboard-popup);
    --b-focus-color: var(--b-whiteboard-focus);
    --b-accent-a: var(--b-marker-a);
    --b-accent-b: var(--b-marker-b);
    --b-accent-c: var(--b-marker-c);
    --b-accent-d: var(--b-marker-d);
}

.b-paper {
    --b-surface-color: var(--b-paper-surface);
    --b-text-color: var(--b-paper-text);
    --b-title-color: var(--b-paper-title);
    --b-line-color: var(--b-paper-line);
    --b-fill-color: var(--b-paper-fill);
    --b-hover-color: var(--b-paper-hover);
    --b-track-color: var(--b-paper-track);
    --b-accent-color: var(--b-paper-accent);
    --b-accent-fill: var(--b-paper-accent-fill);
    --b-accent-text-color: var(--b-paper-accent-text);
    --b-glow-color: var(--b-paper-glow);
    --b-row-color: var(--b-paper-row);
    --b-popup-color: var(--b-paper-popup);
    --b-focus-color: var(--b-paper-accent);
}

.b-glass {
    --b-surface-color: var(--b-glass-surface);
    --b-text-color: var(--b-glass-text);
    --b-title-color: var(--b-glass-title);
    --b-line-color: var(--b-glass-line);
    --b-fill-color: var(--b-glass-fill);
    --b-hover-color: var(--b-glass-hover);
    --b-track-color: var(--b-glass-track);
    --b-accent-color: var(--b-glass-accent);
    --b-accent-fill: var(--b-glass-accent-fill);
    --b-accent-text-color: var(--b-glass-accent-text);
    --b-glow-color: var(--b-glass-glow);
    --b-row-color: var(--b-glass-row);
    --b-popup-color: var(--b-glass-popup);
}

.b-gauge {
    --b-text-color: var(--b-gauge-text);
    --b-line-color: var(--b-gauge-line);
    --b-accent-color: var(--b-gauge-accent);
}

/* ------------------------------------------------------------------ Text */

.unity-text-element {
    -unity-font-definition: var(--b-font);
    -unity-text-generator: advanced;
    color: var(--b-text-color);
}

.b-title {
    font-size: var(--b-title-size);
    -unity-text-align: upper-center;
    color: var(--b-title-color);
}

/* A stroke of colored chalk under a page's title, fading at both ends. */
.b-title-underline {
    height: 6px;
    flex-shrink: 0;
    margin: 0 12px 4px 12px;
    background-image: linear-gradient(90deg, var(--b-accent-a) 0%, var(--b-accent-b) 35%, var(--b-accent-c) 65%, var(--b-accent-d) 100%);
    border-radius: 3px;
    opacity: 0.85;
}

/* ------------------------------------------------------------------ Panes */

.b-pane {
    padding-top: var(--b-pane-padding);
    padding-right: var(--b-pane-padding);
    padding-bottom: var(--b-pane-padding);
    padding-left: var(--b-pane-padding);
    margin: 6px;
    width: 250px;
    border-top-left-radius: var(--b-pane-radius);
    border-top-right-radius: var(--b-pane-radius);
    border-bottom-right-radius: var(--b-pane-radius);
    border-bottom-left-radius: var(--b-pane-radius);
    background-color: var(--b-surface-color);
}

.b-sub-pane {
    padding: 4px;
    border-top-left-radius: var(--b-pane-radius);
    border-top-right-radius: var(--b-pane-radius);
    border-bottom-right-radius: var(--b-pane-radius);
    border-bottom-left-radius: var(--b-pane-radius);
    background-color: var(--b-row-color);
}

.b-screen {
    flex-grow: 1;
}

/* ------------------------------------------------------------------ Buttons */

.unity-button {
    transition-property: background-color, border-color, filter;
    transition-duration: 0.2s;
    border-top-width: var(--b-button-border-width);
    border-right-width: var(--b-button-border-width);
    border-bottom-width: var(--b-button-border-width);
    border-left-width: var(--b-button-border-width);
    border-top-color: var(--b-line-color);
    border-right-color: var(--b-line-color);
    border-bottom-color: var(--b-line-color);
    border-left-color: var(--b-line-color);
    overflow: visible;
    /* -unity-material can't come from a variable: a theme that wants a shader sets it (see T2_Edgy). */
    -unity-material: none;
    background-color: var(--b-fill-color);
    color: var(--b-text-color);
    border-top-left-radius: var(--b-element-radius);
    border-top-right-radius: var(--b-element-radius);
    border-bottom-right-radius: var(--b-element-radius);
    border-bottom-left-radius: var(--b-element-radius);
    padding-top: var(--b-button-padding);
    padding-right: var(--b-button-padding);
    padding-bottom: var(--b-button-padding);
    padding-left: var(--b-button-padding);
    margin-top: var(--b-field-gap);
}

.unity-button:enabled:hover {
    background-color: var(--b-hover-color);
    filter: drop-shadow(0 0 6 var(--b-glow-color));
}

.unity-button.b-primary {
    background-color: var(--b-accent-fill);
    border-top-color: var(--b-accent-color);
    border-right-color: var(--b-accent-color);
    border-bottom-color: var(--b-accent-color);
    border-left-color: var(--b-accent-color);
    color: var(--b-accent-text-color);
}

.unity-button:disabled {
    opacity: 0.45;
}

.b-long-press-button__progress {
    background-color: var(--b-accent-fill);
}

/* ------------------------------------------------------------------ Fields */

.unity-base-field {
    flex-direction: column;
    margin-top: var(--b-field-gap);
}

.unity-base-field__label {
    color: var(--b-text-color);
}

.unity-base-text-field__input {
    background-color: var(--b-fill-color);
    color: var(--b-text-color);
    border-width: 2px;
    border-top-color: var(--b-line-color);
    border-right-color: var(--b-line-color);
    border-bottom-color: var(--b-line-color);
    border-left-color: var(--b-line-color);
    border-top-left-radius: var(--b-inner-radius);
    border-top-right-radius: var(--b-inner-radius);
    border-bottom-right-radius: var(--b-inner-radius);
    border-bottom-left-radius: var(--b-inner-radius);
}

.unity-popup-field__input {
    background-color: var(--b-fill-color);
    color: var(--b-text-color);
    border-width: 2px;
    border-top-color: var(--b-line-color);
    border-right-color: var(--b-line-color);
    border-bottom-color: var(--b-line-color);
    border-left-color: var(--b-line-color);
    border-top-left-radius: var(--b-inner-radius);
    border-top-right-radius: var(--b-inner-radius);
    border-bottom-right-radius: var(--b-inner-radius);
    border-bottom-left-radius: var(--b-inner-radius);
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--b-text-color);
}

/* Dropdown menus open at the panel's root: the board's colors, opaque. */
.unity-base-dropdown__container-inner {
    background-color: var(--b-popup-color);
    border-top-color: var(--b-line-color);
    border-right-color: var(--b-line-color);
    border-bottom-color: var(--b-line-color);
    border-left-color: var(--b-line-color);
    border-top-left-radius: var(--b-inner-radius);
    border-top-right-radius: var(--b-inner-radius);
    border-bottom-right-radius: var(--b-inner-radius);
    border-bottom-left-radius: var(--b-inner-radius);
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:focus {
    background-color: var(--b-hover-color);
}

.unity-base-dropdown__label {
    color: var(--b-text-color);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--b-accent-color);
}

/* ------------------------------------------------------------------ Progress bars */

.unity-progress-bar {
    margin-top: var(--b-field-gap);
}

.unity-progress-bar__container {
    min-height: initial;
    max-height: initial;
    height: auto;
    flex-grow: 1;
}

.unity-progress-bar__background {
    border-width: 2px;
    border-top-color: var(--b-line-color);
    border-right-color: var(--b-line-color);
    border-bottom-color: var(--b-line-color);
    border-left-color: var(--b-line-color);
    min-height: initial;
    max-height: initial;
    background-color: var(--b-track-color);
    border-top-left-radius: var(--b-element-radius);
    border-top-right-radius: var(--b-element-radius);
    border-bottom-right-radius: var(--b-element-radius);
    border-bottom-left-radius: var(--b-element-radius);
}

.unity-progress-bar__title {
    padding-top: var(--b-progress-bar-padding);
    padding-right: var(--b-progress-bar-padding);
    padding-bottom: var(--b-progress-bar-padding);
    padding-left: var(--b-progress-bar-padding);
    color: var(--b-text-color);
}

.unity-progress-bar__progress {
    background-color: var(--b-accent-fill);
    border-top-left-radius: var(--b-inner-radius);
    border-top-right-radius: var(--b-inner-radius);
    border-bottom-right-radius: var(--b-inner-radius);
    border-bottom-left-radius: var(--b-inner-radius);
}

/* ------------------------------------------------------------------ Sliders */

.unity-base-slider--horizontal > .unity-base-slider__input {
    height: 22px;
}

.unity-base-slider--horizontal .unity-base-slider__tracker {
    background-color: var(--b-track-color);
    border-width: 0;
    height: 4px;
    margin-top: -2px;
    border-radius: 2px;
}

.unity-base-slider--horizontal .unity-base-slider__tracker:hover:enabled {
    background-color: var(--b-track-color);
}

.unity-base-slider__drag-container > .unity-base-slider__dragger {
    background-color: var(--b-accent-color);
    border-width: 0;
    border-top-left-radius: var(--b-tiny-radius);
    border-top-right-radius: var(--b-tiny-radius);
    border-bottom-right-radius: var(--b-tiny-radius);
    border-bottom-left-radius: var(--b-tiny-radius);
}

.unity-base-slider--horizontal .unity-base-slider__dragger:hover:enabled {
    border-width: 1px;
    border-top-color: var(--b-glow-color);
    border-right-color: var(--b-glow-color);
    border-bottom-color: var(--b-glow-color);
    border-left-color: var(--b-glow-color);
    background-color: var(--b-accent-color);
    scale: 1.1 1.1;
}

/* ------------------------------------------------------------------ Toggles */

.unity-toggle {
    flex-direction: row;
    align-items: center;
}

.unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    background-color: var(--b-fill-color);
    border-width: 2px;
    border-top-color: var(--b-line-color);
    border-right-color: var(--b-line-color);
    border-bottom-color: var(--b-line-color);
    border-left-color: var(--b-line-color);
    border-top-left-radius: var(--b-tiny-radius);
    border-top-right-radius: var(--b-tiny-radius);
    border-bottom-right-radius: var(--b-tiny-radius);
    border-bottom-left-radius: var(--b-tiny-radius);
    -unity-background-image-tint-color: var(--b-accent-text-color);
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--b-accent-fill);
    border-top-color: var(--b-accent-color);
    border-right-color: var(--b-accent-color);
    border-bottom-color: var(--b-accent-color);
    border-left-color: var(--b-accent-color);
}

/* ------------------------------------------------------------------ Tabs */

.unity-tab-view {
    margin-top: var(--b-field-gap);
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
}

/* The tab headers share the pane's width instead of scrolling. */
.unity-tab-view__header-container {
    flex-grow: 1;
}

/* So there's nothing to scroll: the tab view still makes its scroll buttons, shown until it lays itself out. It
   shows them itself if headers ever don't fit. */
.unity-tab-view__next-button,
.unity-tab-view__previous-button {
    display: none;
    background-color: var(--b-surface-color);
    color: var(--b-text-color);
    border-width: 0;
}

.unity-tab__header {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 0 2px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-top-left-radius: var(--b-inner-radius);
    border-top-right-radius: var(--b-inner-radius);
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.unity-tab__header:hover {
    background-color: var(--b-hover-color);
}

/* A long name shrinks to fit its tab (the Advanced Text Generator's best fit). */
.unity-tab__header-label {
    color: var(--b-text-color);
    opacity: 0.6;
    -unity-text-auto-size: best-fit 9px var(--b-text-size);
}

.unity-tab__header:checked > .unity-tab__header-label {
    opacity: 1;
    color: var(--b-accent-color);
}

/* The chosen tab is underlined, like the title. */
.unity-tab__header-underline {
    height: 3px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.unity-tab__header:checked > .unity-tab__header-underline {
    background-color: var(--b-accent-color);
}

.unity-tab {
    background-color: var(--b-row-color);
    border-top-width: 1px;
    border-top-color: var(--b-track-color);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: var(--b-pane-radius);
    border-bottom-left-radius: var(--b-pane-radius);
    padding: 7px;
}

/* ------------------------------------------------------------------ Lists */

.unity-multi-column-header {
    min-height: initial;
}

.unity-multi-column-view__header-container {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 2px;
    border-bottom-color: var(--b-line-color);
}

.unity-multi-column-header__column {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0 1px 0 0;
    border-top-color: var(--b-track-color);
    border-right-color: var(--b-track-color);
    border-bottom-color: var(--b-track-color);
    border-left-color: var(--b-track-color);
}

.unity-multi-column-header__column:hover:enabled {
    background-color: var(--b-hover-color);
}

.unity-multi-column-header__column__title {
    color: var(--b-accent-color);
}

.unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
}

.unity-list-view__item.unity-collection-view__item--alternative-background {
    background-color: var(--b-row-color);
}

.unity-list-view__item:hover:enabled {
    background-color: var(--b-hover-color);
}

/* ------------------------------------------------------------------ Scroll bars: thin strokes */

.unity-scroller__low-button,
.unity-scroller__high-button {
    border-width: 0;
    border-top-left-radius: var(--b-inner-radius);
    border-top-right-radius: var(--b-inner-radius);
    border-bottom-right-radius: var(--b-inner-radius);
    border-bottom-left-radius: var(--b-inner-radius);
    background-color: var(--b-fill-color);
    -unity-background-image-tint-color: var(--b-text-color);
}

.unity-scroller__slider,
.unity-scroller__slider > .unity-slider__input {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller__slider .unity-base-slider__dragger {
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    background-color: var(--b-line-color);
}

.unity-scroller--vertical > .unity-base-slider--vertical {
    padding-top: 4px;
    padding-bottom: 4px;
}

.unity-scroller__slider > .unity-slider__input > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    background-color: var(--b-track-color);
    border-width: 0;
    width: 2px;
    left: 50%;
    margin-left: -1px;
}

/* ------------------------------------------------------------------ Focus: gamepad and keyboard players need to see where they are */

.unity-button:focus,
.b-long-press-button:focus {
    border-top-color: var(--b-focus-color);
    border-right-color: var(--b-focus-color);
    border-bottom-color: var(--b-focus-color);
    border-left-color: var(--b-focus-color);
}

.unity-base-text-field:focus > .unity-base-field__input,
.unity-base-popup-field:focus > .unity-base-field__input,
.unity-base-slider:focus .unity-base-slider__dragger,
.unity-toggle:focus .unity-toggle__checkmark,
.unity-tab__header:focus,
.unity-collection-view:focus,
.b-focus-frame:focus {
    border-top-width: var(--b-focus-width);
    border-right-width: var(--b-focus-width);
    border-bottom-width: var(--b-focus-width);
    border-left-width: var(--b-focus-width);
    border-top-color: var(--b-focus-color);
    border-right-color: var(--b-focus-color);
    border-bottom-color: var(--b-focus-color);
    border-left-color: var(--b-focus-color);
}

/* ------------------------------------------------------------------ Settings > Reduce Motion and Visual Effects
   set these classes on each screen's root. Filters (blur, shadows, the chalk) are the most expensive
   things the UI draws. */

.b-reduce-motion .unity-button,
.b-reduce-motion .b-pane,
.b-reduce-motion .unity-base-slider__dragger {
    transition-duration: 0s;
}

.b-reduce-motion .b-title-box:hover {
    -unity-animation-clip: none;
}

.b-no-visual-effects .unity-button:enabled:hover,
.b-no-visual-effects .b-pane:disabled,
.b-no-visual-effects .b-chalk {
    filter: none;
}

.b-no-visual-effects .b-pane {
    backdrop-filter: none;
}

/* ------------------------------------------------------------------ Right to left */

/* b-rtl is on screens in a language written right to left (FollowsLanguage), whose text the Advanced Text
   Generator lays out right to left. UI Toolkit's rows and text alignment don't turn around by themselves: text
   that starts at the left starts at the right, and rows that read in order run from the right. What's about
   places stays put: the arrows that move along the bagels, the two sides of the HUD. */
.b-rtl {
    -unity-text-align: upper-right;
}

.b-rtl .unity-toggle,
.b-rtl .unity-tab-view__header-container,
.b-rtl .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row-reverse;
}

/* A slider grows the way the line runs. */
.b-rtl .unity-base-slider--horizontal > .unity-base-slider__input {
    scale: -1 1;
}

/* A table's first column is on the right, its titles start at the right, and the lines between the columns are
   on their left. */
.b-rtl .unity-multi-column-header__column-container,
.b-rtl .unity-multi-column-view__row-container,
.b-rtl .unity-multi-column-header__column__content {
    flex-direction: row-reverse;
}

.b-rtl .unity-multi-column-header__column {
    border-width: 0 0 0 1px;
}

/* Daylight: a sunny morning. The blackboard wears a cream paper menu, the window is bright frosted
   glass, and everything is ink with warm orange. Only variables. */

:root {
    --b-sound-tone: bell;

    --b-board-surface: rgba(255, 248, 234, 0.94);
    --b-board-text: rgb(59, 31, 20);
    --b-board-title: rgb(222, 72, 44);
    --b-board-line: rgb(214, 160, 110);
    --b-board-fill: rgb(255, 255, 255);
    --b-board-hover: rgb(255, 232, 196);
    --b-board-track: rgba(59, 31, 20, 0.14);
    --b-board-accent: rgb(245, 140, 35);
    --b-board-accent-fill: rgb(245, 166, 35);
    --b-board-accent-text: rgb(59, 31, 20);
    --b-board-glow: rgb(255, 214, 120);
    --b-board-row: rgba(245, 166, 35, 0.12);
    --b-board-popup: rgb(255, 248, 234);
    --b-board-sign: rgb(255, 248, 234);
    --b-frame-color: rgb(214, 160, 110);

    --b-paper-surface: rgb(255, 255, 255);
    --b-paper-accent: rgb(245, 140, 35);
    --b-paper-accent-fill: rgb(245, 166, 35);
    --b-paper-accent-text: rgb(59, 31, 20);

    --b-glass-surface: rgba(255, 252, 244, 0.72);
    --b-glass-text: rgb(59, 31, 20);
    --b-glass-title: rgb(222, 72, 44);
    --b-glass-line: rgb(214, 160, 110);
    --b-glass-fill: rgba(255, 255, 255, 0.8);
    --b-glass-hover: rgb(255, 232, 196);
    --b-glass-track: rgba(59, 31, 20, 0.14);
    --b-glass-accent: rgb(245, 140, 35);
    --b-glass-accent-fill: rgb(245, 166, 35);
    --b-glass-accent-text: rgb(59, 31, 20);
    --b-glass-glow: rgb(255, 214, 120);
    --b-glass-popup: rgb(255, 248, 234);

    --b-accent-a: rgb(255, 196, 40);
    --b-accent-b: rgb(255, 138, 101);
    --b-accent-c: rgb(222, 72, 44);
    --b-accent-d: rgb(64, 201, 132);

    --b-focus-color: rgb(222, 72, 44);
    --b-focus-width: 3px;
    --b-board-filter: none;

    --b-tiny-radius: 5px;
    --b-inner-radius: 10px;
    --b-element-radius: 14px;
    --b-pane-radius: 24px;
}

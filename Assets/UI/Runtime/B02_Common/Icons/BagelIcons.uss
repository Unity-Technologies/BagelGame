/* The game's icons: SVGs drawn for Bagel Game, one class each, so any element can show one:
   <ui:VisualElement class="b-icon b-icon--stat-speed"/>. Every theme imports this sheet. */

.b-icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* The bagel stats, on the price tags and the HUD. */
.b-icon--stat-toppings {
    background-image: url("stat-toppings.svg");
}

.b-icon--stat-topping-loss {
    background-image: url("stat-topping-loss.svg");
}

.b-icon--stat-control {
    background-image: url("stat-control.svg");
}

.b-icon--stat-speed {
    background-image: url("stat-speed.svg");
}

.b-icon--stat-grip {
    background-image: url("stat-grip.svg");
}

/* The themes, in Settings and the Editor's theme pickers. */
.b-icon--theme-classic {
    background-image: url("theme-classic.svg");
}

.b-icon--theme-edgy {
    background-image: url("theme-edgy.svg");
}

.b-icon--theme-daylight {
    background-image: url("theme-daylight.svg");
}

.b-icon--theme-high-contrast {
    background-image: url("theme-high-contrast.svg");
}

/* The languages: a speech bubble with the language's letters drawn in it. */
.b-icon--language-en {
    background-image: url("language-en.svg");
}

.b-icon--language-fr {
    background-image: url("language-fr.svg");
}

.b-icon--language-zh-Hans {
    background-image: url("language-zh-Hans.svg");
}

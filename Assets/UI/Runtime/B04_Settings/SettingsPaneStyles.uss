.unity-scroll-view {
    height: 147px;
}

/* The theme's icon beside its dropdown. */
.b-theme-row {
    flex-direction: row;
    align-items: flex-end;
}

.b-theme-row__icon {
    width: 30px;
    height: 30px;
    margin: 0 6px 2px 0;
}

.b-rtl .b-theme-row,
.b-rtl .b-controls-row {
    flex-direction: row-reverse;
}

.b-rtl .b-theme-row__icon {
    margin: 0 0 2px 6px;
}

.b-theme-row__dropdown {
    flex-grow: 1;
}

.b-controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.b-controls-row__label {
    flex-shrink: 1;
}

.b-controls-row__button {
    min-width: 90px;
}

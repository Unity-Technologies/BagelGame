<ui:UXML xmlns:loc="Unity.Localization" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="GameSettingsPane" src="project://database/Assets/UI/Runtime/B04_Settings/SettingsPaneForGame.uxml?fileID=9197481963319205126&amp;guid=d7691f3c73ec72640bed89b7079805d7&amp;type=3#SettingsPaneForGame"/>
    <ui:Template name="UISettingsPane" src="project://database/Assets/UI/Runtime/B04_Settings/SettingsPaneForUI.uxml?fileID=9197481963319205126&amp;guid=e1093797146b3f046962391299b2fdb9&amp;type=3#SettingsPaneForUI"/>
    <ui:Template name="GraphicsSettingsPane" src="project://database/Assets/UI/Runtime/B04_Settings/SettingsPaneForGraphics.uxml?fileID=9197481963319205126&amp;guid=cc52e5c4f3ef4b7fabb12145c7b9a081&amp;type=3#SettingsPaneForGraphics"/>
    <ui:Template name="ControlsSettingsPane" src="project://database/Assets/UI/Runtime/B04_Settings/SettingsPaneForControls.uxml?fileID=9197481963319205126&amp;guid=0e6997991f18fff47a6a6e1e04bcf7a9&amp;type=3#SettingsPaneForControls"/>
    <ui:Template name="AboutSettingsPane" src="project://database/Assets/UI/Runtime/B04_Settings/SettingsPaneForAbout.uxml?fileID=9197481963319205126&amp;guid=30f584607186493aae04b986dd9c25d2&amp;type=3#SettingsPaneForAbout"/>
    <Style src="project://database/Assets/UI/Runtime/B04_Settings/SettingsPaneStyles.uss?fileID=7433441132597879392&amp;guid=8078ac1b834d2b244a237e4c2907d5d5&amp;type=3#SettingsPaneStyles"/>
    <Bagel.SettingsPaneManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="settings-pane-manager" class="b-settings">
        <ui:TabView name="settings-tab-view" class="b-settings__tabs">
            <ui:Tab label="Game" name="game-settings-tab" class="b-wipe">
                <Bindings>
                    <loc:LocalizedString property="label" table="BagelStrings" entry="settings.tab-game"/>
                </Bindings>
                <ui:Instance template="GameSettingsPane" name="game-settings-pane" class="b-settings__page"/>
            </ui:Tab>
            <ui:Tab label="Look" name="ui-settings-tab" class="b-wipe">
                <Bindings>
                    <loc:LocalizedString property="label" table="BagelStrings" entry="settings.tab-ui"/>
                </Bindings>
                <ui:Instance template="UISettingsPane" name="ui-settings-pane" class="b-settings__page"/>
            </ui:Tab>
            <ui:Tab label="Graphics" name="graphics-settings-tab" class="b-wipe">
                <Bindings>
                    <loc:LocalizedString property="label" table="BagelStrings" entry="settings.tab-graphics"/>
                </Bindings>
                <ui:Instance template="GraphicsSettingsPane" name="graphics-settings-pane" class="b-settings__page"/>
            </ui:Tab>
            <ui:Tab label="Controls" name="controls-settings-tab" class="b-wipe">
                <Bindings>
                    <loc:LocalizedString property="label" table="BagelStrings" entry="settings.tab-controls"/>
                </Bindings>
                <ui:Instance template="ControlsSettingsPane" name="controls-settings-pane" class="b-settings__page"/>
            </ui:Tab>
            <ui:Tab label="About" name="about-settings-tab" class="b-wipe">
                <Bindings>
                    <loc:LocalizedString property="label" table="BagelStrings" entry="settings.tab-about"/>
                </Bindings>
                <ui:Instance template="AboutSettingsPane" name="about-settings-pane" class="b-settings__page"/>
            </ui:Tab>
        </ui:TabView>
        <ui:Label text="Settings" name="page-title" picking-mode="Ignore" class="b-title b-settings__title"/>
        <ui:VisualElement name="page-title-underline" picking-mode="Ignore" class="b-title-underline b-settings__underline"/>
        <ui:VisualElement name="back-item" class="b-settings__back">
            <ui:Button text="Back" name="back-button" class="b-settings__back-button">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="common.back"/>
                </Bindings>
                <Bagel.PressSquish/>
            </ui:Button>
            <ui:VisualElement picking-mode="Ignore" class="b-chalk-item__line"/>
        </ui:VisualElement>
    </Bagel.SettingsPaneManager>
</ui:UXML>

/* The main menu, chalked on the shop's blackboard, and Settings in marker on the whiteboard beside it.
   The panel lies across both boards (the blackboard 20 wide, a gap, the whiteboard 26 wide, at 0.056 a
   pixel); the camera moves from one to the other, and the board not in use fades: chalk smudges, marker
   ghosts. The leaderboard is on the television. */

.b-screen {
    flex-direction: row;
    align-items: center;
}

#main-menu-screen {
    flex-grow: 0;
    width: 864px;
    height: 289px;
}

/* The chalk's grain over everything on the blackboard (a custom filter; none in themes without chalk). */
.b-chalk {
    filter: var(--b-board-filter);
}

.b-pane {
    transition-property: filter, opacity;
    transition-duration: 1s;
}

/* ------------------------------------------------------------------ The blackboard */

#main-menu-pane {
    width: 357px;
    height: 282px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

/* The menu clips at the board's edges: the chalk filter's texture then always starts at the same corner, and
   its grain stays put however the title moves. */
.b-chalk-menu {
    flex-grow: 1;
    overflow: hidden;
    padding: 8px 18px 6px 18px;
}

/* The board not in use, smudged like chalk wiped with a sleeve. */
#main-menu-pane:disabled {
    filter: blur(6);
    opacity: 0.5;
}

.b-title.b-main-title {
    align-self: center;
    padding: 0;
    margin: 0;
    font-size: var(--b-main-title-size);
    color: var(--b-title-color);
}

.b-title-box {
    align-self: flex-start;
    width: 238px;
    margin: 30px 0 18px 34px;
}

.b-title-box:hover {
    -unity-animation-clip: url("project://database/Assets/UI/Runtime/B03_MainMenu/MainMenuTitleAnimation.asset?fileID=3358089438549323042&guid=2c825b0b649574fa39cfb0ff1fc02eca&type=2#MainMenuTitleAnimation");
}

/* Doodles around the title, drawn in the board's colors. */
.b-title-doodle {
    position: absolute;
    color: var(--b-text-color);
    --b-doodle-width: 2.5;
}

.b-title-doodle--bagel {
    width: 54px;
    height: 38px;
    right: -44px;
    bottom: 0;
    color: var(--b-accent-b);
}

.b-title-doodle--steam {
    width: 30px;
    height: 26px;
    right: -32px;
    bottom: 32px;
    opacity: 0.8;
}

.b-title-doodle--sparkle {
    width: 20px;
    height: 20px;
    left: 10px;
    top: 6px;
    color: var(--b-accent-a);
}

/* The menu: big words in chalk, each underlined. Pointing at one, or moving the focus to it
   (.b-chalk-item--focus), chalks an arrow beside it and underlines it again, brighter; pressing it squishes it.
   No boxes, no glow. */
#secondary-buttons-row {
    flex-direction: column;
    align-items: flex-start;
}

.b-chalk-item {
    align-self: flex-start;
    margin: 0 0 2px 64px;
}

.b-chalk-item--primary {
    margin-bottom: 6px;
}

.b-chalk-item__button,
.b-chalk-item__button.b-primary {
    margin: 0;
    padding: 0 6px 7px 6px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--b-text-color);
    font-size: 22px;
    -unity-text-align: middle-left;
    transition-property: color;
    transition-duration: 0.2s;
}

.b-chalk-item__button.b-primary {
    font-size: 34px;
    color: var(--b-title-color);
}

.b-chalk-item__button:enabled:hover,
.b-chalk-item__button.b-primary:enabled:hover {
    background-color: rgba(0, 0, 0, 0);
    filter: none;
}

.b-chalk-item__button:focus {
    border-width: 0;
}

.b-chalk-item__underline {
    position: absolute;
    left: 2px;
    right: 0;
    bottom: 0;
    height: 9px;
    opacity: 0.4;
    color: var(--b-text-color);
    --b-doodle-width: 2.5;
}

.b-chalk-item--primary > .b-chalk-item__underline {
    color: var(--b-title-color);
    --b-doodle-width: 3.5;
}

/* Underlined again: drawn in from the start of the word. */
.b-chalk-item__underline--again,
.b-chalk-item--primary > .b-chalk-item__underline--again {
    opacity: 0;
    scale: 0 1;
    transform-origin: left;
    color: var(--b-focus-color);
    transition-property: scale, opacity;
    transition-duration: 0.25s, 0.1s;
    transition-timing-function: ease-out-cubic, linear;
}

.b-chalk-item__arrow {
    position: absolute;
    left: -40px;
    top: 50%;
    width: 34px;
    height: 22px;
    margin-top: -14px;
    opacity: 0;
    translate: -8px 0;
    color: var(--b-focus-color);
    --b-doodle-width: 3;
    transition-property: opacity, translate;
    transition-duration: 0.2s;
}

.b-chalk-item:hover > .b-chalk-item__underline--again,
.b-chalk-item--focus > .b-chalk-item__underline--again {
    opacity: 1;
    scale: 1 1;
}

.b-chalk-item:hover > .b-chalk-item__arrow,
.b-chalk-item--focus > .b-chalk-item__arrow {
    opacity: 1;
    translate: 0 0;
}

/* Right to left: the words line up on the right, the arrow points in from the right. */
.b-rtl .b-title-box {
    align-self: flex-end;
    margin: 30px 34px 18px 0;
}

.b-rtl #secondary-buttons-row {
    align-items: flex-end;
}

.b-rtl .b-chalk-item {
    align-self: flex-end;
    margin-left: 0;
    margin-right: 64px;
}

.b-rtl .b-chalk-item__button {
    -unity-text-align: middle-right;
}

.b-rtl .b-chalk-item__underline--again {
    transform-origin: right;
}

.b-rtl .b-chalk-item__arrow {
    left: auto;
    right: -40px;
    scale: -1 1;
}

/* ------------------------------------------------------------------ The whiteboard */

#secondary-panes {
    flex-shrink: 0;
    width: 464px;
    height: 289px;
    margin-left: 43px;
    padding: 8px 14px;
}

/* Settings fill the whiteboard, set smaller than elsewhere so more of them show at once. */
#secondary-panes > .b-pane {
    flex-grow: 1;
    width: auto;
    height: auto;
    margin: 0;
    padding: 4px 6px;
    --b-text-size: 11px;
}

/* The board not in use: the marker's ghost, still sharp, as on a whiteboard wiped a little too quickly. */
#secondary-panes > .b-pane:disabled {
    filter: none;
    opacity: 0.25;
}

#secondary-panes .b-title {
    font-size: 24px;
}

#secondary-panes .unity-tab__header-label,
#secondary-panes .unity-button {
    font-size: 11px;
}

#secondary-panes .unity-tab-view {
    flex-grow: 1;
}

#secondary-panes .unity-tab-view__content-container,
#secondary-panes .unity-tab {
    flex-grow: 1;
}

#secondary-panes .unity-scroll-view {
    flex-grow: 1;
    height: auto;
}

/* Marker on a whiteboard: crisp lines, no glow. */
#secondary-panes .unity-button {
    min-height: 22px;
    border-top-left-radius: var(--b-tiny-radius);
    border-top-right-radius: var(--b-tiny-radius);
    border-bottom-right-radius: var(--b-tiny-radius);
    border-bottom-left-radius: var(--b-tiny-radius);
    --b-button-border-width: 2px;
}

#secondary-panes .unity-button:enabled:hover {
    filter: none;
}

#secondary-panes .unity-tab__header:checked > .unity-tab__header-label {
    color: var(--b-title-color);
}

#secondary-panes .unity-tab__header:checked > .unity-tab__header-underline {
    background-color: var(--b-title-color);
}

/* ------------------------------------------------------------------ Scroll bars */

.unity-scroller--vertical {
    width: 14px;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    width: 14px;
    height: 14px;
    border-radius: 7px;
}

.unity-scroller__slider > .unity-slider__input {
    width: 14px;
}

.unity-scroller__slider .unity-base-slider__dragger {
    width: 6px;
    margin-left: 4px;
}

.unity-scroller--vertical > .unity-base-slider--vertical {
    margin-top: 14px;
    margin-bottom: 14px;
}

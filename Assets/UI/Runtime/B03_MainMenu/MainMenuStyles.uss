/* The main menu and Settings: chalk on the shop's blackboard. The main pane is on the left and Settings on
   the right; the camera moves over to it, and the other one smudges. The leaderboard is on the television. */

.b-screen {
    flex-direction: row;
    flex-grow: 1;
}

/* The chalk's grain over everything on the board (a custom filter; none in themes without chalk). */
.b-chalk {
    filter: var(--b-board-filter);
}

/* The board reaches past its panes, far enough for the title (bouncing too) and the blur of the pane not in
   use, and clips there: the chalk filter's texture then always starts at the same corner, and its grain stays
   put however the title moves. The margins take back what the padding adds, so the panel keeps its size. */
#main-menu-screen {
    overflow: hidden;
    margin: -80px -20px -20px -64px;
    padding: 80px 20px 20px 64px;
}

.b-pane {
    background-color: var(--b-surface-color);
    transition-property: filter, opacity;
    transition-duration: 1s;
    height: 277px;
}

/* Settings and the Leaderboard take the rest of the board, wider than the menu and set smaller, so more of
   them shows at once; the camera comes close for them. */
#secondary-panes > .b-pane {
    width: 400px;
    --b-text-size: 12px;
}

#secondary-panes .b-title {
    font-size: 24px;
}

#secondary-panes .unity-tab__header-label,
#secondary-panes .unity-button {
    font-size: 12px;
}

#secondary-panes .unity-button {
    min-height: 26px;
}

#secondary-panes .unity-scroll-view {
    height: 168px;
}

/* The pane not in use, smudged like chalk wiped with a sleeve. */
.b-pane:disabled {
    filter: blur(6);
    opacity: 0.5;
}

.b-title.b-main-title {
    padding: 0;
    margin: 0;
    font-size: var(--b-main-title-size);
    color: var(--b-title-color);
}

.b-title-box:hover {
    -unity-animation-clip: url("project://database/Assets/UI/Runtime/B03_MainMenu/MainMenuTitleAnimation.asset?fileID=3358089438549323042&guid=2c825b0b649574fa39cfb0ff1fc02eca&type=2#MainMenuTitleAnimation");
}

/* Doodles around the title, drawn in the board's colors. */
.b-title-doodle {
    position: absolute;
    color: var(--b-text-color);
    --b-doodle-width: 2.5;
}

.b-title-doodle--bagel {
    width: 54px;
    height: 38px;
    right: -44px;
    bottom: 0;
    color: var(--b-accent-b);
}

.b-title-doodle--steam {
    width: 30px;
    height: 26px;
    right: -32px;
    bottom: 32px;
    opacity: 0.8;
}

.b-title-doodle--sparkle {
    width: 20px;
    height: 20px;
    left: 10px;
    top: 6px;
    color: var(--b-accent-a);
}

.b-details-view {
    font-size: var(--b-details-size);
}

.b-details-view .unity-label {
    padding: 1px;
    margin: 1px;
}

.unity-scroller--vertical {
    width: 16px;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

.unity-scroller__slider > .unity-slider__input {
    width: 16px;
}

.unity-scroller__slider .unity-base-slider__dragger {
    width: 6px;
    margin-left: 5px;
}

.unity-scroller--vertical > .unity-base-slider--vertical {
    margin-top: 16px;
    margin-bottom: 16px;
}

#secondary-buttons-row {
    flex-direction: row;
}

/* Two buttons share a row: less padding, so "Leaderboard" fits. */
#secondary-buttons-row > .unity-button {
    padding-left: 2px;
    padding-right: 2px;
}

.b-rtl #secondary-buttons-row {
    flex-direction: row-reverse;
}

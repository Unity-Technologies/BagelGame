.b-pane {
    background-image: linear-gradient(135deg, var(--b-card-color-a) 0%, var(--b-card-color-b) 65%, var(--b-card-color-c) 100%);
}

.b-title,
.unity-progress-bar__title {
    color: var(--b-card-text-color);
}

.bar-row {
    flex-direction: row;
    align-items: center;
}

.bar-icon {
    width: 34px;
    height: 34px;
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
}

.unity-progress-bar {
    flex-grow: 1;
}

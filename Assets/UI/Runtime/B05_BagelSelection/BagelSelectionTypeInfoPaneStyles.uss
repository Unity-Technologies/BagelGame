/* A bagel's price tag, standing on the counter by its bagel: a paper card with a deli label across the
   top, and its stats as rows of pips in a grid (icon, name, pips). */

.b-tag {
    padding: 0 0 8px 0;
    border-width: 2px;
    border-color: var(--b-line-color);
    overflow: hidden;
    /* A little sheen in the paper's top corner. */
    background-image: radial-gradient(ellipse farthest-corner at 20% 0%, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0) 60%);
}

/* The deli label: the bagel's name, in the paper's accent. */
.b-tag__header {
    background-color: var(--b-accent-fill);
    border-bottom-width: 2px;
    border-bottom-color: var(--b-line-color);
    padding: 2px 6px 0 6px;
    margin-bottom: 6px;
}

.b-tag__name {
    color: var(--b-accent-text-color);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* Grid layout: the icons, names and pips line up in three columns, whatever the language. */
.b-tag__stats {
    display: grid;
    grid-template-columns: 30px 1fr 64px;
    row-gap: 4px;
    column-gap: 6px;
    align-items: center;
    padding: 0 8px;
}

.b-tag__icon {
    width: 30px;
    height: 30px;
}

.b-tag__label {
    font-size: 13px;
    padding: 0;
    margin: 0;
    white-space: normal;
}

.b-tag__meter {
    height: 14px;
    color: var(--b-line-color);
    --b-meter-color: var(--b-accent-color);
}

/* Right to left: the columns turn around (dense, so each row fills from its first cell), and the pips fill from
   the right. */
.b-rtl .b-tag__stats {
    grid-template-columns: 64px 1fr 30px;
    grid-auto-flow: row-dense;
}

.b-rtl .b-tag__icon {
    grid-column-start: 3;
}

.b-rtl .b-tag__label {
    grid-column-start: 2;
}

.b-rtl .b-tag__meter {
    grid-column-start: 1;
    scale: -1 1;
}

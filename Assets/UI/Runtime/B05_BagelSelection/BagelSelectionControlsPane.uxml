<ui:UXML xmlns:loc="Unity.Localization" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Runtime/B05_BagelSelection/BagelSelectionControlsPaneStyles.uss?fileID=7433441132597879392&amp;guid=f063789375bb83d44afc4665135919ee&amp;type=3#BagelSelectionControlsPaneStyles"/>
    <Bagel.BagelSelectionControlsPaneManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="pane" focusable="true" class="b-pane b-register b-focus-frame b-focus-group">
        <ui:VisualElement name="display" picking-mode="Ignore" class="b-register__display">
            <ui:Label text="Sesame" name="display-name" picking-mode="Ignore" class="b-register__name"/>
        </ui:VisualElement>
        <ui:VisualElement name="keys" class="b-register__keys">
            <ui:Button text="&lt;" name="left-button" focusable="false" language-direction="LTR" class="b-register__key b-register__key--arrow">
                <Bagel.PressSquish/>
            </ui:Button>
            <ui:Button text="&gt;" name="right-button" focusable="false" language-direction="LTR" class="b-register__key b-register__key--arrow">
                <Bagel.PressSquish/>
            </ui:Button>
            <ui:Button text="Back" name="back-button" focusable="false" class="b-register__key b-register__key--back">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="common.back"/>
                </Bindings>
                <Bagel.PressSquish/>
            </ui:Button>
            <ui:Button text="Order" name="select-button" focusable="false" class="b-register__key b-register__key--order b-primary">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="selection.order"/>
                </Bindings>
                <Bagel.PressSquish/>
            </ui:Button>
        </ui:VisualElement>
    </Bagel.BagelSelectionControlsPaneManager>
</ui:UXML>

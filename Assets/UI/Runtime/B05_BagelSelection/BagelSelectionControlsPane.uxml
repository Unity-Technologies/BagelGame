<ui:UXML xmlns:loc="Unity.Localization" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Runtime/B05_BagelSelection/BagelSelectionControlsPaneStyles.uss?fileID=7433441132597879392&amp;guid=f063789375bb83d44afc4665135919ee&amp;type=3#BagelSelectionControlsPaneStyles"/>
    <Bagel.BagelSelectionControlsPaneManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="pane" focusable="true" class="b-pane b-focus-frame">
        <ui:Button text="&lt;" name="left-button">
            <Bagel.PressSquish/>
        </ui:Button>
        <ui:VisualElement name="navigation-buttons" class="b-button-bar">
            <ui:Button text="Select" name="select-button" class="b-primary">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="selection.select"/>
                </Bindings>
                <Bagel.PressSquish/>
            </ui:Button>
            <ui:Button text="Back" name="back-button">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="common.back"/>
                </Bindings>
                <Bagel.PressSquish/>
            </ui:Button>
        </ui:VisualElement>
        <ui:Button text="&gt;" name="right-button">
            <Bagel.PressSquish/>
        </ui:Button>
    </Bagel.BagelSelectionControlsPaneManager>
</ui:UXML>

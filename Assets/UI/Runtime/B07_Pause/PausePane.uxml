<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Page" src="project://database/Assets/UI/Runtime/B02_Common/Page.uxml?fileID=9197481963319205126&amp;guid=fd2407f521d49554aaf933ac922100de&amp;type=3#Page"/>
    <Style src="project://database/Assets/UI/Runtime/B07_Pause/PauseScreenStyles.uss?fileID=7433441132597879392&amp;guid=c737b2b4b88a73b488932f7d380c919c&amp;type=3#PauseScreenStyles"/>
    <Bagel.PausePaneManager name="pause-pane-manager">
        <ui:Instance template="Page" name="pause-page">
            <AttributeOverrides element-name="page-title" text="Paused"/>
            <ui:Button text="Resume" name="resume-button" class="b-primary"/>
            <ui:Button text="Settings" name="settings-button"/>
            <Bagel.LongPressButton name="restart-button" text="Restart"/>
            <Bagel.LongPressButton name="main-menu-button" text="Main Menu"/>
        </ui:Instance>
    </Bagel.PausePaneManager>
</ui:UXML>

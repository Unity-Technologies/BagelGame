<ui:UXML xmlns:loc="Unity.Localization" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Page" src="project://database/Assets/UI/Runtime/B02_Common/Page.uxml?fileID=9197481963319205126&amp;guid=fd2407f521d49554aaf933ac922100de&amp;type=3#Page"/>
    <Style src="project://database/Assets/UI/Runtime/B07_Pause/PauseScreenStyles.uss?fileID=7433441132597879392&amp;guid=c737b2b4b88a73b488932f7d380c919c&amp;type=3#PauseScreenStyles"/>
    <Bagel.PausePaneManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="pause-pane-manager">
        <ui:Instance template="Page" name="pause-page">
            <AttributeOverrides element-name="page-title" text="Paused"/>
            <ui:Button text="Resume" name="resume-button" class="b-primary">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="pause.resume"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Settings" name="settings-button">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="menu.settings"/>
                </Bindings>
            </ui:Button>
            <Bagel.LongPressButton name="restart-button" text="Restart">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="common.restart"/>
                </Bindings>
            </Bagel.LongPressButton>
            <Bagel.LongPressButton name="main-menu-button" text="Main Menu">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="common.main-menu"/>
                </Bindings>
            </Bagel.LongPressButton>
        </ui:Instance>
    </Bagel.PausePaneManager>
</ui:UXML>

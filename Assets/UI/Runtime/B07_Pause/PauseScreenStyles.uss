/* Paused: the game freezes behind the shop window. The pane is frosted glass (backdrop-filter, which
   only screen-space panels have) lettered in gold leaf, like a bakery's window sign. */

.b-screen {
    justify-content: center;
    align-items: center;
    /* The game dims a little behind the window. */
    background-image: radial-gradient(ellipse farthest-corner at center, rgba(20, 12, 6, 0) 30%, rgba(20, 12, 6, 0.55) 100%);
}

.b-pane {
    width: 320px;
    padding: 22px 26px 26px 26px;
    border-width: 2px;
    border-color: var(--b-line-color);
    border-radius: 26px;
    backdrop-filter: blur(18);
}

.b-glass .b-title {
    letter-spacing: 3px;
    text-shadow: 0 2px 0 rgba(40, 24, 14, 0.6);
}

/* Gold leaf: a fine gold rule rather than the chalk's colors. */
.b-glass .b-title-underline {
    background-image: none;
    background-color: var(--b-accent-color);
    height: 2px;
    border-radius: 0;
    margin: 0 30px 10px 30px;
}

.b-inactive-pane {
    display: none;
}

/* Settings: wider than the pause buttons, its text smaller, so more of it shows at once. */
#settings-pane {
    width: 480px;
    --b-text-size: 13px;
}

#settings-pane .b-title {
    font-size: 28px;
}

#settings-pane .b-details-view {
    font-size: 12px;
}

#settings-pane .unity-tab__header-label,
#settings-pane .unity-button {
    font-size: 13px;
}

#settings-pane .unity-scroll-view {
    height: 230px;
}

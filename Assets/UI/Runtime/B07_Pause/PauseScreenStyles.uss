/* Paused: the game freezes behind the shop window. The pane is frosted glass (backdrop-filter, which
   only screen-space panels have) lettered in gold leaf, like a bakery's window sign. */

.b-screen {
    justify-content: center;
    align-items: center;
    /* The game dims a little behind the window. */
    background-image: radial-gradient(ellipse farthest-corner at center, rgba(20, 12, 6, 0) 30%, rgba(20, 12, 6, 0.55) 100%);
}

.b-pane {
    width: 320px;
    padding: 22px 26px 26px 26px;
    border-width: 2px;
    border-color: var(--b-line-color);
    border-radius: 26px;
    backdrop-filter: blur(18);
}

.b-glass .b-title {
    letter-spacing: 3px;
    text-shadow: 0 2px 0 rgba(40, 24, 14, 0.6);
}

/* Gold leaf: a fine gold rule rather than the chalk's colors. */
.b-glass .b-title-underline {
    background-image: none;
    background-color: var(--b-accent-color);
    height: 2px;
    border-radius: 0;
    margin: 0 30px 10px 30px;
}

.b-inactive-pane {
    display: none;
}

/* Settings: the blackboard's window of tabs, on the glass, at the pause buttons' size. The chosen tab is a pane of
   darker glass with a gold rule under it; choices are gold-leaf pills. */
#settings-pane {
    width: auto;
    flex-shrink: 0;
    --b-text-size: 14px;
}

#settings-pane .b-settings__title {
    font-size: 30px;
}

#settings-pane .b-title-underline {
    margin: 0;
}

#settings-pane .unity-tab__header {
    padding: 4px 12px 6px 12px;
    margin-left: -12px;
    border-radius: 10px;
}

#settings-pane .unity-tab__header:checked {
    background-color: var(--b-fill-color);
}

#settings-pane .unity-tab__header-label {
    font-size: 16px;
}

#settings-pane .unity-tab__header-underline {
    left: 12px;
    right: 12px;
    width: auto;
}

#settings-pane .unity-button {
    font-size: 14px;
}

#settings-pane .unity-button-group__button {
    border-radius: 14px;
    border-width: 2px;
    padding: 2px 7px;
    margin-right: 5px;
    font-size: 12px;
}

#settings-pane .unity-button-group__button:checked {
    background-color: var(--b-accent-fill);
    border-color: var(--b-accent-color);
    color: var(--b-accent-text-color);
}

#settings-pane .b-theme-card {
    border-radius: 14px;
}

/* Back is a glass button here: no chalk line under it. */
#settings-pane .b-chalk-item__line {
    display: none;
}

#settings-pane .b-settings__back-button {
    margin: 0;
    min-width: 110px;
}

#settings-pane .b-theme-card:checked {
    background-color: var(--b-fill-color);
    border-color: var(--b-accent-color);
}

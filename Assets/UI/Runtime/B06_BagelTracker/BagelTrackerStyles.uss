/* The kitchen gauges riding along with the bagel, on two wings: the speed on the left, with the knocks (spin
   and pain) smaller under it, and the toppings on the right. No words: each gauge's face says what it shows
   (BagelGauge). Each wing curves towards the camera like a cockpit's screen (Curved UI: it only shows on
   world-space panels) and folds back when the bagel gets close to a wall (BagelHud). */

.b-hud {
    width: initial;
    align-self: flex-start;
    align-items: center;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: opacity;
    transition-duration: 0.25s;
}

.b-hud--left,
.b-hud--right {
    -unity-curvature: 0deg 24deg;
}

.b-hud--left {
    align-items: flex-end;
}

/* Folded against a wall: the details step back. */
.b-hud--folded {
    opacity: 0.55;
}

/* An enamel face in a steel rim, a little sheen at its top. */
.b-hud__gauge {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 4px;
    border-color: var(--b-gauge-rim);
    background-color: var(--b-gauge-surface);
    background-image: radial-gradient(ellipse farthest-side at 50% 25%, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 70%);
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.b-hud__gauge--big {
    width: 84px;
    height: 84px;
    border-radius: 42px;
}

.b-hud__gauge--small {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    border-width: 3px;
    margin: 0 0 0 4px;
}

/* Under the speed, lined up on the wing's inner edge, next to the bagel. */
.b-hud__knocks {
    flex-direction: row;
    align-self: flex-end;
}

/* The spin gauge's little bagel, turning in the middle. */
.b-gauge-dial__spinner {
    position: absolute;
    width: 44%;
    height: 44%;
    left: 28%;
    top: 28%;
}

.b-gauge-dial__needle {
    position: absolute;
    width: 4px;
    height: 42%;
    left: 50%;
    bottom: 50%;
    margin-left: -2px;
    border-radius: 2px;
    background-color: var(--b-gauge-accent);
    transform-origin: 50% 100%;
}

.b-gauge-dial__hub {
    position: absolute;
    width: 12px;
    height: 12px;
    left: 50%;
    top: 50%;
    margin-left: -6px;
    margin-top: -6px;
    border-radius: 6px;
    background-color: var(--b-gauge-line);
}

.b-hud__count {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--b-gauge-text);
    padding: 0;
    margin: 0;
}

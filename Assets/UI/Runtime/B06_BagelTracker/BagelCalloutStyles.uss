/* A callout over the bagel: "Ready..." and "Go!". It's a screen-space panel
   that follows the bagel (PanelRenderer.trackScreenSpacePosition), so it stays sharp and the same size
   on screen wherever the bagel is, unlike the gauges around it, which are in the world. Being in screen
   space, it can be frosted glass (backdrop-filter). */

.b-callout {
    translate: -50% -100%;
    padding: 4px 14px;
    border-width: 2px;
    border-color: var(--b-line-color);
    border-radius: 16px;
    background-color: var(--b-surface-color);
    backdrop-filter: blur(8);
}

.b-callout--hidden {
    display: none;
}

.b-callout--pop {
    -unity-animation-clip: url("/Assets/UI/Runtime/B06_BagelTracker/BagelCalloutAnimation.asset");
}

.b-callout__label {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--b-title-color);
    padding: 0;
    margin: 0;
}

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Runtime/B06_BagelTracker/BagelTrackerStyles.uss?fileID=7433441132597879392&amp;guid=f44a3d6467ce34ac08c12a3a0311ca4b&amp;type=3#BagelTrackerStyles"/>
    <Bagel.BagelTrackerPaneManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="pane" data-source-path="tracker" class="b-pane b-gauge b-hud b-hud--right" authoring-id="1730612002">
        <Bagel.BagelGauge kind="Seeds" name="toppings-gauge" class="b-hud__gauge b-hud__gauge--big">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="toppingsCount" binding-mode="ToTarget"/>
                <ui:DataBinding property="maxValue" data-source-path="toppingsMaxCount" binding-mode="ToTarget"/>
            </Bindings>
            <ui:Label text="1,000" name="toppings-count" class="b-hud__count"/>
        </Bagel.BagelGauge>
        <ui:VisualElement name="knocks" class="b-hud__knocks">
            <Bagel.BagelGauge kind="Spin" name="spin-gauge" class="b-hud__gauge b-hud__gauge--small">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="spin" binding-mode="ToTarget"/>
                    <ui:DataBinding property="maxValue" data-source-path="constants.spinMax" binding-mode="ToTarget"/>
                </Bindings>
            </Bagel.BagelGauge>
            <Bagel.BagelGauge kind="Pain" name="pain-gauge" class="b-hud__gauge b-hud__gauge--small">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="force" binding-mode="ToTarget"/>
                    <ui:DataBinding property="maxValue" data-source-path="constants.forceMax" binding-mode="ToTarget"/>
                </Bindings>
            </Bagel.BagelGauge>
        </ui:VisualElement>
    </Bagel.BagelTrackerPaneManager>
</ui:UXML>

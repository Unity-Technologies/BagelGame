<ui:UXML xmlns:loc="Unity.Localization" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Runtime/B06_BagelTracker/BagelTrackerStyles.uss?fileID=7433441132597879392&amp;guid=f44a3d6467ce34ac08c12a3a0311ca4b&amp;type=3#BagelTrackerStyles"/>
    <Bagel.BagelTrackerPaneManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="pane" data-source-path="tracker" class="b-pane b-gauge b-hud b-hud--right" authoring-id="1730612002">
        <ui:VisualElement name="toppings" class="b-hud__dial b-hud__dial--big">
            <Bagel.BagelGauge kind="Seeds" name="toppings-gauge" class="b-hud__gauge">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="toppingsCount" binding-mode="ToTarget"/>
                    <ui:DataBinding property="maxValue" data-source-path="toppingsMaxCount" binding-mode="ToTarget"/>
                </Bindings>
                <ui:Label text="1,000" name="toppings-count" class="b-hud__count"/>
            </Bagel.BagelGauge>
            <ui:Label text="Toppings" name="toppings-label" class="b-hud__caption">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="stat.toppings"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="knocks" class="b-hud__bars">
            <ui:ProgressBar name="spin-bar" title="Spin" class="b-hud__bar">
                <Bindings>
                    <loc:LocalizedString property="title" table="BagelStrings" entry="tracker.spin"/>
                    <ui:DataBinding property="value" data-source-path="spin" binding-mode="ToTarget"/>
                    <ui:DataBinding property="highValue" data-source-path="constants.spinMax" binding-mode="ToTarget"/>
                </Bindings>
            </ui:ProgressBar>
            <ui:ProgressBar name="pain-bar" title="Pain" class="b-hud__bar">
                <Bindings>
                    <loc:LocalizedString property="title" table="BagelStrings" entry="tracker.pain"/>
                    <ui:DataBinding property="value" data-source-path="force" binding-mode="ToTarget"/>
                    <ui:DataBinding property="highValue" data-source-path="constants.forceMax" binding-mode="ToTarget"/>
                </Bindings>
            </ui:ProgressBar>
        </ui:VisualElement>
    </Bagel.BagelTrackerPaneManager>
</ui:UXML>

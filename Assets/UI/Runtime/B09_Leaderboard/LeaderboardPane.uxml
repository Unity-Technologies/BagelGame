<ui:UXML xmlns:loc="Unity.Localization" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Page" src="project://database/Assets/UI/Runtime/B02_Common/Page.uxml?fileID=9197481963319205126&amp;guid=fd2407f521d49554aaf933ac922100de&amp;type=3#Page"/>
    <Style src="project://database/Assets/UI/Runtime/B09_Leaderboard/LeaderboardPaneStyles.uss?fileID=7433441132597879392&amp;guid=a89750b4a27696d4aa631f637c338db0&amp;type=3#LeaderboardPaneStyles"/>
    <Bagel.LeaderboardManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="leaderboard-manager" style="flex-grow: 1;">
        <ui:Instance template="Page" name="leaderboard-page">
            <AttributeOverrides element-name="page-title" text="Leaderboard"/>
            <ui:VisualElement name="level-switcher" class="b-leaderboard__levels">
                <ui:Button text="&lt;" name="previous-level-button" language-direction="LTR" class="b-leaderboard__level-button"/>
                <ui:Label text="Breakfast" name="level-name" class="b-leaderboard__level-name"/>
                <ui:Button text="&gt;" name="next-level-button" language-direction="LTR" class="b-leaderboard__level-button"/>
            </ui:VisualElement>
            <ui:MultiColumnListView columns="" sort-column-descriptions="" name="leaderboard-table" allow-add="false" allow-remove="false" show-bound-collection-size="false" show-alternating-row-backgrounds="ContentOnly" virtualization-method="DynamicHeight" sorting-mode="Default" selection-type="None" class="b-details-view">
                <ui:SortColumnDescriptions>
                    <ui:SortColumnDescription column-name="toppings" direction="Descending"/>
                </ui:SortColumnDescriptions>
                <ui:Columns reorderable="false" primary-column-name="name">
                    <ui:Column name="name" title="Name" stretchable="true" optional="false"/>
                    <ui:Column name="toppings" title="Toppings Left" stretchable="true" optional="false"/>
                    <ui:Column name="time" title="Time" stretchable="true" optional="false"/>
                </ui:Columns>
            </ui:MultiColumnListView>
            <ui:Button text="Back" name="back-button">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="common.back"/>
                </Bindings>
            </ui:Button>
        </ui:Instance>
    </Bagel.LeaderboardManager>
</ui:UXML>

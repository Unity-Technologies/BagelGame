<ui:UXML xmlns:loc="Unity.Localization" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Runtime/B13_Labels/JamLabelStyles.uss?fileID=7433441132597879392&amp;guid=647c253e91fb4d1aaa9eb1821671a14e&amp;type=3#JamLabelStyles"/>
    <ui:VisualElement name="jam-label" picking-mode="Ignore" class="b-paper b-jam-label">
        <ui:Label text="Strawberry Jam" name="jam-name" picking-mode="Ignore" class="b-jam-label__name">
            <Bindings>
                <loc:LocalizedString property="text" table="BagelStrings" entry="label.jam"/>
            </Bindings>
        </ui:Label>
        <ui:Label text="Homemade" name="jam-note" picking-mode="Ignore" class="b-jam-label__note">
            <Bindings>
                <loc:LocalizedString property="text" table="BagelStrings" entry="label.homemade"/>
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>

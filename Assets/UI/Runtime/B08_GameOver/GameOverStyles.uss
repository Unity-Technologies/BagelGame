/* Game over, floating over the counter: the run's receipt, torn off the till, with the result stamped
   on it, and the leaderboard on a little chalkboard sign beside it. */

.b-game-over {
    width: 600px;
    height: 500px;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.b-pane-half {
    flex-grow: 1;
    flex-basis: 0;
}

/* The receipt lies a little crooked over the sign's edge: z-index puts it on top, though the sign
   comes after it. */
.b-pane-half--receipt {
    margin-right: -10px;
    rotate: -2deg;
    z-index: 1;
}

/* ------------------------------------------------------------------ The receipt */

.b-receipt-holder {
    flex-grow: 1;
}

.b-receipt {
    flex-grow: 1;
    padding: 10px 14px 4px 14px;
    background-color: var(--b-surface-color);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.b-receipt__edge {
    height: 10px;
    flex-shrink: 0;
    color: var(--b-paper-surface);
}

.b-receipt__shop {
    -unity-text-align: middle-center;
    font-size: 12px;
    letter-spacing: 2px;
    opacity: 0.75;
    padding: 0;
    margin: 0 0 2px 0;
}

.b-receipt .b-title {
    font-size: 26px;
}

/* On paper the title's underline is a ruled line, not chalk. */
.b-receipt .b-title-underline {
    background-image: none;
    background-color: var(--b-line-color);
    height: 2px;
    border-radius: 0;
    opacity: 0.5;
    margin: 0 0 6px 0;
}

/* Grid layout: what was bought on the left, its price on the right. */
.b-receipt__lines {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 2px;
    column-gap: 8px;
    padding: 4px 0;
    margin: 4px 0 6px 0;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--b-track-color);
}

.b-receipt__item,
.b-receipt__price {
    font-size: 13px;
    padding: 0;
    margin: 0;
}

.b-receipt__price {
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.b-receipt__form {
    padding: 2px 6px 6px 6px;
}

.b-receipt__buttons {
    flex-direction: row;
    column-gap: 6px;
    margin-top: 2px;
}

.b-receipt__buttons > .unity-button {
    flex-grow: 1;
    flex-basis: 0;
}

/* Right to left: what was bought on the right, its price on the left. */
.b-rtl .b-receipt__lines {
    grid-template-columns: auto 1fr;
    grid-auto-flow: row-dense;
}

.b-rtl .b-receipt__item {
    grid-column-start: 2;
}

.b-rtl .b-receipt__price {
    grid-column-start: 1;
}

.b-rtl .b-receipt__price {
    -unity-text-align: middle-left;
}

.b-rtl .b-receipt__buttons {
    flex-direction: row-reverse;
}

.b-receipt__thanks {
    -unity-text-align: middle-center;
    font-size: 11px;
    opacity: 0.7;
    margin: 4px 0 0 0;
    padding: 0;
}

.b-summary {
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 13px;
    margin: 0;
}

/* The result, stamped in red ink across the receipt. */
.b-stamp {
    align-self: center;
    rotate: -8deg;
    margin: 2px 0 4px 0;
    padding: 0 10px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--b-paper-accent);
    border-width: 3px;
    border-color: var(--b-paper-accent);
    border-radius: 6px;
    opacity: 0.85;
}

/* Lost (crumbled or stale): stamped in plain ink. */
.b-stamp--lost {
    color: var(--b-paper-text);
    border-color: var(--b-paper-text);
}

/* Restarted from code to slam the stamp down each time the screen shows. */
.b-stamp--slam {
    -unity-animation-clip: url("/Assets/UI/Runtime/B08_GameOver/GameOverStampAnimation.asset");
}

/* ------------------------------------------------------------------ The leaderboard's sign */

#leaderboard > #leaderboard-manager > #leaderboard-page > #back-button {
    display: none;
}

.b-sign {
    padding: 8px;
}

/* The television on the bakery's far wall: it always shows the last run's receipt on the left and the
   leaderboard on the right, big enough to read across the room. At game over the receipt has the
   leaderboard's form and its buttons (.b-tv--game-over); opened from the main menu, the leaderboard has
   its Back button (.b-tv--leaderboard). The panel lies on the screen's glass, as big as it is (16:9). */

.b-game-over {
    width: 960px;
    height: 540px;
    flex-direction: column;
    margin: 0;
    padding: 10px 22px 22px 22px;
    border-radius: 0;
    background-color: var(--b-tv-screen-bottom);
    background-image: linear-gradient(180deg, var(--b-tv-screen-top) 0%, var(--b-tv-screen-bottom) 100%);
    --b-text-size: 18px;
}

/* The channel's bug in the corner, as on any broadcast. */
.b-tv__bug {
    flex-direction: row;
    align-items: center;
    height: 26px;
    flex-shrink: 0;
    margin-bottom: 6px;
    opacity: 0.8;
}

.b-tv__bug-icon {
    width: 36px;
    height: 26px;
    color: var(--b-tv-bug-color);
    --b-doodle-width: 2.5;
}

.b-tv__bug-label {
    color: var(--b-tv-bug-color);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 0 0 0 8px;
    margin: 0;
}

.b-rtl .b-tv__bug {
    flex-direction: row-reverse;
}

.b-tv__picture {
    flex-direction: row;
    flex-grow: 1;
}

.b-rtl .b-tv__picture {
    flex-direction: row-reverse;
}

.b-pane-half {
    flex-grow: 1;
    flex-basis: 0;
}

/* A card on the screen: paper, edged in the accent's ink. */
.b-tv__card {
    margin: 0 9px;
    padding: 8px 16px;
    background-color: var(--b-paper-surface);
    border-width: 3px;
    border-color: var(--b-paper-accent);
    border-radius: 10px;
}

/* Only at game over: the leaderboard's form and the buttons. Only from the main menu: the leaderboard's Back. */
.b-game-over #leaderboard-form,
.b-game-over #bottom-container,
#leaderboard #back-button {
    display: none;
}

.b-tv--game-over #leaderboard-form,
.b-tv--game-over #bottom-container,
.b-tv--leaderboard #leaderboard #back-button {
    display: flex;
}

/* ------------------------------------------------------------------ The receipt */

.b-receipt-holder {
    flex-grow: 1;
}

.b-receipt {
    flex-grow: 1;
    padding: 4px 2px 0 2px;
}

.b-receipt__shop {
    -unity-text-align: middle-center;
    font-size: 14px;
    letter-spacing: 2px;
    opacity: 0.75;
    padding: 0;
    margin: 0 0 2px 0;
}

.b-receipt .b-title {
    font-size: 30px;
}

/* On paper the title's underline is a ruled line, not chalk. */
.b-receipt .b-title-underline {
    background-image: none;
    background-color: var(--b-line-color);
    height: 2px;
    border-radius: 0;
    opacity: 0.5;
    margin: 0 0 6px 0;
}

/* Grid layout: what was bought on the left, its price on the right. */
.b-receipt__lines {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 2px;
    column-gap: 8px;
    padding: 4px 0;
    margin: 4px 0 6px 0;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--b-track-color);
}

.b-receipt__item,
.b-receipt__price {
    font-size: 16px;
    padding: 0;
    margin: 0;
}

.b-receipt__price {
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

/* The name and its button side by side, to leave the receipt room for the rest. */
.b-receipt__form {
    flex-direction: row;
    align-items: flex-end;
    column-gap: 8px;
    padding: 2px 8px 8px 8px;
}

.b-receipt__form > .unity-text-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.b-receipt__form > .unity-button {
    flex-shrink: 0;
}

.b-rtl .b-receipt__form {
    flex-direction: row-reverse;
}

.b-receipt__buttons {
    flex-direction: row;
    column-gap: 8px;
    margin-top: 4px;
}

.b-receipt__buttons > .unity-button {
    flex-grow: 1;
    flex-basis: 0;
}

/* Right to left: what was bought on the right, its price on the left. */
.b-rtl .b-receipt__lines {
    grid-template-columns: auto 1fr;
    grid-auto-flow: row-dense;
}

.b-rtl .b-receipt__item {
    grid-column-start: 2;
}

.b-rtl .b-receipt__price {
    grid-column-start: 1;
}

.b-rtl .b-receipt__price {
    -unity-text-align: middle-left;
}

.b-rtl .b-receipt__buttons {
    flex-direction: row-reverse;
}

.b-receipt__thanks {
    -unity-text-align: middle-center;
    font-size: 14px;
    opacity: 0.7;
    margin: 4px 0 0 0;
    padding: 0;
}

.b-summary {
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 16px;
    margin: 0;
}

/* No run yet: the receipt only says so. */
.b-receipt--empty #stamp,
.b-receipt--empty #receipt-lines {
    display: none;
}

.b-receipt--empty .b-summary {
    margin: 40px 0;
    font-size: 22px;
}

/* The result, stamped in red ink across the receipt. */
.b-stamp {
    align-self: center;
    rotate: -8deg;
    margin: 2px 0 4px 0;
    padding: 0 12px;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--b-paper-accent);
    border-width: 3px;
    border-color: var(--b-paper-accent);
    border-radius: 6px;
    opacity: 0.85;
}

/* Lost (crumbled): stamped in plain ink. */
.b-stamp--lost {
    color: var(--b-paper-text);
    border-color: var(--b-paper-text);
}

/* Restarted from code to slam the stamp down each time the screen shows. */
.b-stamp--slam {
    -unity-animation-clip: url("/Assets/UI/Runtime/B08_GameOver/GameOverStampAnimation.asset");
}

/* ------------------------------------------------------------------ The leaderboard */

.b-game-over .unity-multi-column-header__column__title {
    font-size: 17px;
}

.b-game-over .unity-multi-column-view__row-container .unity-label {
    font-size: 19px;
    padding: 2px 4px;
}

<ui:UXML xmlns:loc="Unity.Localization" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Page" src="project://database/Assets/UI/Runtime/B02_Common/Page.uxml?fileID=9197481963319205126&amp;guid=fd2407f521d49554aaf933ac922100de&amp;type=3#Page"/>
    <Style src="project://database/Assets/UI/Runtime/B08_GameOver/GameOverStyles.uss?fileID=7433441132597879392&amp;guid=c43ec4f477b5206419e80814c13a81c4&amp;type=3#GameOverStyles"/>
    <Bagel.GameOverPaneManager start-state="project://database/Assets/Game/Core/PlayManagerState.asset?fileID=11400000&amp;guid=f0183f196e1622f4aa5ff36423fe939f&amp;type=2#PlayManagerState" name="game-over-pane-manager" class="b-receipt-holder">
        <ui:VisualElement name="receipt" class="b-paper b-receipt">
            <ui:Label text="Bagel Game Bakery" name="receipt-shop" class="b-receipt__shop">
                <Bindings>
                    <loc:LocalizedString property="text" table="BagelStrings" entry="receipt.shop"/>
                </Bindings>
            </ui:Label>
            <ui:Instance template="Page" name="game-over-page">
                <AttributeOverrides element-name="page-title" text="Game Over"/>
                <ui:Label text="Toasted!" name="stamp" picking-mode="Ignore" class="b-stamp"/>
                <ui:Label name="summary-label" class="b-summary"/>
                <ui:VisualElement name="receipt-lines" class="b-receipt__lines">
                    <ui:Label text="Toppings kept" name="toppings-title-label" class="b-receipt__item">
                        <Bindings>
                            <loc:LocalizedString property="text" table="BagelStrings" entry="receipt.toppings"/>
                        </Bindings>
                    </ui:Label>
                    <ui:IntegerField value="42" name="toppings-number-field" readonly="true" class="b-receipt__price">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="lastRun.toppings" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:IntegerField>
                    <ui:Label text="Time" name="time-title-label" class="b-receipt__item">
                        <Bindings>
                            <loc:LocalizedString property="text" table="BagelStrings" entry="receipt.time"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="0:00.0" name="time-label" class="b-receipt__price"/>
                    <ui:Label text="Freshness" name="freshness-title-label" class="b-receipt__item">
                        <Bindings>
                            <loc:LocalizedString property="text" table="BagelStrings" entry="receipt.freshness"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="100%" name="freshness-label" class="b-receipt__price"/>
                </ui:VisualElement>
                <ui:VisualElement name="leaderboard-form" class="b-sub-pane b-receipt__form">
                    <ui:TextField label="Name for Leaderboard" name="leaderboard-name-field">
                        <Bindings>
                            <loc:LocalizedString property="label" table="BagelStrings" entry="gameover.name"/>
                        </Bindings>
                    </ui:TextField>
                    <ui:Button text="Add to Leaderboard" name="add-to-leaderboard-button">
                        <Bindings>
                            <loc:LocalizedString property="text" table="BagelStrings" entry="gameover.add"/>
                        </Bindings>
                        <Bagel.PressSquish/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="bottom-container" class="b-receipt__buttons">
                    <ui:Button text="Restart" name="restart-button">
                        <Bindings>
                            <loc:LocalizedString property="text" table="BagelStrings" entry="common.restart"/>
                        </Bindings>
                        <Bagel.PressSquish/>
                    </ui:Button>
                    <ui:Button text="Main Menu" name="main-menu-button" class="b-primary">
                        <Bindings>
                            <loc:LocalizedString property="text" table="BagelStrings" entry="common.main-menu"/>
                        </Bindings>
                        <Bagel.PressSquish/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label text="Thank you, come again!" name="receipt-thanks" class="b-receipt__thanks">
                    <Bindings>
                        <loc:LocalizedString property="text" table="BagelStrings" entry="receipt.thanks"/>
                    </Bindings>
                </ui:Label>
            </ui:Instance>
        </ui:VisualElement>
        <Bagel.ReceiptEdge name="receipt-edge" class="b-receipt__edge"/>
    </Bagel.GameOverPaneManager>
</ui:UXML>
